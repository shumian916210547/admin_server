{
  "name": "admin_server",
  "version": "1.0.0",
  "description": "Secure Node.js Express BFF for schema-driven multi-tenant admin APIs with RBAC, organization scopes, Parse Server and PostgreSQL.",
  "private": true,
  "main": "app.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shumian916210547/admin_server.git"
  },
  "homepage": "https://github.com/shumian916210547/admin_server#readme",
  "bugs": {
    "url": "https://github.com/shumian916210547/admin_server/issues"
  },
  "keywords": [
    "nodejs",
    "express",
    "bff",
    "express-bff",
    "low-code",
    "schema-driven",
    "rbac",
    "multi-tenant",
    "tenant-isolation",
    "organization-tree",
    "parse-server",
    "postgresql",
    "csrf",
    "http-only-cookie",
    "admin-api"
  ],
  "scripts": {
    "start": "node app.js",
    "start:dev": "node --watch app.js",
    "dev": "node app.js",
    "prod": "pm2 start ecosystem.config.js --env production",
    "seed:initial": "node scripts/seed-initial-data.js",
    "security:harden": "node scripts/harden-parse.js",
    "security:check": "node scripts/security-check.js",
    "check": "node scripts/check.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "parse": "^8.6.0",
    "parse-server": "^9.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ip-address": "^10.4.0",
    "ws": "^8.21.3"
  }
}
