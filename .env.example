# Copy this file to .env and replace every placeholder before starting the API.
# Do not commit .env or deploy these values in frontend build variables.
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
PARSE_INTERNAL_HOST=127.0.0.1
PARSE_INTERNAL_PORT=1337

# A PostgreSQL URI with a dedicated, least-privilege application account.
DATABASE_URI=postgres://app_user:replace-with-a-strong-password@127.0.0.1:5432/shumian_admin
PARSE_APP_ID=replace-with-a-random-app-id
PARSE_MASTER_KEY=replace-with-a-long-random-master-key
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
INITIAL_ADMIN_USERNAME=replace-with-initial-admin-username
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# The browser should call the BFF through this origin (normally via the same-origin /api proxy).
PUBLIC_ORIGIN=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
AUTH_COOKIE_NAME=shumian_admin_session
AUTH_TTL_SECONDS=2592000
UPLOAD_MAX_BYTES=10485760
UPLOAD_STORAGE_DIR=resources

# Optional legacy MiniApp login. It is disabled by default and is not mounted
# by the public BFF. A multi-tenant MiniApp requires a separately reviewed,
# server-side membership resolver; never accept a tenant ID from the client.
ENABLE_LEGACY_MINIAPP_LOGIN=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MINIAPP_ACCOUNT_SECRET=
MINIAPP_COMPANY_ID=
MINIAPP_IDENTITY_ID=
